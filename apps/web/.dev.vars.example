# Copy to .dev.vars for local development (wrangler and vite dev read it).
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001
# Telnyx API key (Portal > Keys & Credentials > API Keys). Leave empty to log
# emails and texts to the console instead of sending them.
TELNYX_API_KEY=
# Telnyx's Ed25519 public key (Portal > Keys & Credentials > Public Key),
# which signs every webhook to /api/telnyx/webhook. See README "Email".
# Leave empty locally unless you are testing the webhook.
TELNYX_PUBLIC_KEY=
